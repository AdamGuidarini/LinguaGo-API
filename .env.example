# Copy to .env and fill in real values. Never commit .env — it is gitignored.
# These are read by app/src/config.ts at startup.

# Apertium APY base URL (required)
APY_URL=http://localhost:2737

# LibreTranslate base URL (required)
LT_URL=http://localhost:5000

# LibreTranslate API key (optional — only needed for key-protected instances)
# LT_KEY=

# Port the Express server listens on (optional, defaults to 3000)
# PORT=3000

# --- CORS (all optional) ---
# Single web origin to allow (e.g. a hosted frontend). For multiple origins
# use CORS_ALLOWED_ORIGINS instead.
# CORS_DOMAIN=https://app.example.com

# Comma-separated list of extra exact origins to allow.
# Use '*' to allow any origin — development only, never in prod!
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Allow browser-extension origins (moz-extension://<uuid>, chrome-extension://<id>).
# Extension UUIDs are random per install, so they can only be allowed by scheme.
# Defaults to true; set to 'false' to disable.
# CORS_ALLOW_EXTENSION_ORIGINS=true

# Comma-separated request headers the client may send. Defaults to Content-Type.
# CORS_ALLOWED_HEADERS=Content-Type,Authorization
