# Copy to .env and fill in real values. Never commit .env — it is gitignored.
# These are read by app/src/config.ts at startup.

# Apertium APY base URL (required)
APY_URL=http://localhost:2737

# LibreTranslate base URL (required)
LT_URL=http://localhost:5000

# LibreTranslate API key (optional — only needed for key-protected instances)
# LT_KEY=

# Port the Express server listens on (optional, defaults to 3000)
# PORT=3000
